# ---------------------------------------------------------------------------
# DanielLive — variáveis de ambiente
#
# Copie para .env.local e ajuste. NUNCA versione credenciais reais: o
# .gitignore já bloqueia .env.local, .env.production e afins.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ Sinalização
# Endereço público do servidor de sinalização (WebSocket).
# Deixe vazio para o cliente deduzir sozinho a partir da própria origem
# (mesmo host, porta 8787) — funciona em desenvolvimento e em máquina única.
# Em produção com domínios separados: wss://signal.seudominio.com
NEXT_PUBLIC_SIGNAL_URL=

# Porta em que o servidor de sinalização escuta (server/index.mjs).
SIGNAL_PORT=8787

# Interface de escuta. 0.0.0.0 aceita conexões de fora do host.
SIGNAL_HOST=0.0.0.0

# Origens autorizadas a abrir o WebSocket, separadas por vírgula.
# OBRIGATÓRIO em produção: o servidor se recusa a iniciar sem esta lista, porque
# sem ela qualquer site pode usar o seu servidor como transporte de sinalização.
# Exemplo: https://daniellive.exemplo.com,https://www.daniellive.exemplo.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------- ICE/STUN
# Servidores STUN, separados por vírgula. Os padrões (Google) atendem à maioria
# das redes domésticas. Troque pelos seus se quiser independência.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ------------------------------------------------------------------ ICE/TURN
# TURN é o que salva conexões em rede corporativa, NAT simétrico ou firewall
# que bloqueia UDP. Sem TURN, essas redes simplesmente não conectam.
#
# Para o TURN funcionar no navegador, as credenciais precisam chegar ao cliente
# (por isso o prefixo NEXT_PUBLIC_). Use credenciais efêmeras geradas por um
# serviço como coturn com REST API ou um provedor gerenciado (Cloudflare,
# Twilio, Metered) — nunca uma credencial de longa duração com banda aberta.
#
# NEXT_PUBLIC_TURN_URL=turn:turn.seudominio.com:3478
# NEXT_PUBLIC_TURN_USERNAME=usuario-efemero
# NEXT_PUBLIC_TURN_CREDENTIAL=credencial-efemera

# ------------------------------------------------------------------- Site
# Usado nos metadados quando o site é servido atrás de proxy.
# NEXT_PUBLIC_SITE_URL=https://daniellive.exemplo.com

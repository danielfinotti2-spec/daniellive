# Bot do DanielLive no Discord
#
# Copie este arquivo para .env (ou .env.local) na raiz do projeto e preencha.
# O .env não vai para o git.

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# Token do bot.
# Discord Developer Portal → sua aplicação → Bot → Reset Token.
# É um segredo: quem tem este valor controla o bot.
DISCORD_TOKEN=

# Onde o DanielLive está publicado. O link no chat será
# {DANIELLIVE_ORIGIN}{DANIELLIVE_PATH}/{chave}
# Precisa ser https (só localhost aceita http, para desenvolvimento).
DANIELLIVE_ORIGIN=https://daniellive.onrender.com

# ── Opcionais ────────────────────────────────────────────────────────────────

# Prefixo da sala. O padrão combina com a rota real do site.
DANIELLIVE_PATH=/assistir

# Necessária só para registrar os comandos slash (node bot/registrar.mjs).
# General Information → Application ID.
DISCORD_CLIENT_ID=

# Se preenchido, os comandos são registrados só neste servidor e aparecem
# na hora. Vazio = global (pode levar até 1 hora para aparecer).
DISCORD_GUILD_ID=
